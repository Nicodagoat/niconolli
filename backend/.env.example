# Application
APP_NAME="GHG Emissions Platform"
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ghg_user:ghg_pass@localhost:5432/ghg_emissions
DATABASE_SYNC_URL=postgresql://ghg_user:ghg_pass@localhost:5432/ghg_emissions

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Emission Factor APIs (optional)
IEA_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
