# ---------------------------------------------------------------------------
# Trenord Strike Monitor - configurazione
# Copia questo file in `.env` e compila i valori.
# ---------------------------------------------------------------------------

# URL della pagina avvisi Trenord (di norma non va cambiato)
AVVISI_URL=https://www.trenord.it/news/trenord-informa/avvisi/

# Intervallo di controllo in ore
CHECK_INTERVAL_HOURS=6

# Timeout richieste HTTP in secondi
REQUEST_TIMEOUT=30

# User-Agent usato per le richieste (il sito è dietro Akamai: serve un UA da browser)
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# Percorsi (relativi alla cartella del progetto)
DB_PATH=data/avvisi.sqlite3
ICS_DIR=data/ics
LOG_DIR=logs
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
# ID del calendario su cui creare gli eventi (l'indirizzo Gmail del calendario primario)
GOOGLE_CALENDAR_ID=niccolonolli@gmail.com

# Metodo di autenticazione: "service_account" oppure "oauth"
GOOGLE_AUTH_METHOD=service_account

# Se GOOGLE_AUTH_METHOD=service_account:
# percorso del file JSON della chiave del service account.
# Il calendario va condiviso con l'email del service account
# (permesso "Apportare modifiche agli eventi").
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json

# Se GOOGLE_AUTH_METHOD=oauth:
# client OAuth "Desktop app" scaricato da Google Cloud Console e
# token generato con `python scripts/google_oauth_setup.py`.
GOOGLE_OAUTH_CLIENT_SECRETS=secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/oauth_token.json

# ---------------------------------------------------------------------------
# Telegram (opzionale: notifica quando viene rilevato uno sciopero)
# Lascia vuoto per disabilitare.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
