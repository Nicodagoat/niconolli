# ---------------------------------------------------------------------------
# Trenord Strike Monitor - configurazione
# Copia questo file in `.env` e compila i valori.
# ---------------------------------------------------------------------------

AVVISI_URL=https://www.trenord.it/news/trenord-informa/avvisi/
CHECK_INTERVAL_HOURS=6
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

DB_PATH=data/avvisi.sqlite3
ICS_DIR=data/ics
LOG_DIR=logs
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=niccolonolli@gmail.com

# Per uso personale/locale usa "oauth" (nessun service account richiesto).
# Per server/Docker/GitHub Actions usa "service_account".
GOOGLE_AUTH_METHOD=oauth

GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
GOOGLE_OAUTH_CLIENT_SECRETS=secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/oauth_token.json

# ---------------------------------------------------------------------------
# Telegram (opzionale)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
